# Local (container Docker do README):
DATABASE_URL=postgresql+psycopg://power:power@localhost:5432/power_routine
TEST_DATABASE_URL=postgresql+psycopg://power:power@localhost:5432/power_routine_test

# Neon: cole a connection string do painel como esta (postgresql://...?sslmode=require);
# o prefixo vira postgresql+psycopg:// automaticamente (app/core/config.py).
# TEST_DATABASE_URL precisa apontar para OUTRO database terminado em _test: o
# pytest apaga o schema inteiro dele a cada execucao.

# Opcional -- origens extras autorizadas pelo CORS, como lista JSON:
# CORS_ORIGINS=["https://felipeatorres006.github.io"]
